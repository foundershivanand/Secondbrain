{
  "name": "second-brain",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Second Brain - Compressed Knowledge, Hierarchical Retrieval, Provenance & Lineage",
  "scripts": {
    "dev:api": "cd api && npm run dev",
    "dev:web": "cd web && npm run dev",
    "build": "cd web && npm run build",
    "build:web": "cd web && npm run build",
    "typecheck": "cd api && npm run typecheck",
    "test": "vitest run",
    "db:init:local": "cd api && npx wrangler d1 execute second_brain --local --file=./schema.sql",
    "db:init:remote": "cd api && npx wrangler d1 execute second_brain --remote --file=./schema.sql",
    "seed": "node scripts/seed-demo.mjs",
    "seed:remote": "node scripts/seed-demo.mjs --remote",
    "sync:vault": "node scripts/sync-vault.mjs",
    "sync:cloud": "curl -s -X POST -H 'Authorization: Bearer secondbrain_dev_secret' https://second-brain-api.foundershivanand.workers.dev/api/sync/all",
    "db:sync:remote": "node scripts/push-to-remote-d1.mjs",
    "scan:raw": "node scripts/scan-raw-storage.mjs",
    "brain:reset": "node scripts/reset-brain-data.mjs",
    "sync:youtube": "node scripts/sync-youtube.mjs"
  },
  "keywords": [
    "second-brain",
    "obsidian",
    "cloudflare-workers",
    "cloudflare-d1",
    "gemini",
    "knowledge-graph",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.114.17"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
